{
  "name": "ccaudit",
  "version": "0.1.0",
  "description": "Audit what Claude Code actually did to your files — a single shareable HTML report",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/4thIS/opensource_contest_cpt.git"
  },
  "homepage": "https://github.com/4thIS/opensource_contest_cpt#readme",
  "bugs": {
    "url": "https://github.com/4thIS/opensource_contest_cpt/issues"
  },
  "keywords": [
    "claude-code",
    "claude",
    "audit",
    "diff",
    "report",
    "cli",
    "git"
  ],
  "type": "module",
  "bin": {
    "ccaudit": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "engines": {
    "node": ">=18.3.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepublishOnly": "npm run build && npm test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "diff": "^5.2.0"
  },
  "devDependencies": {
    "@types/diff": "^5.2.0",
    "@types/node": "^20.14.0",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
